{
  "name": "weather-app",
  "version": "2.0.0",
  "private": true,
  "description": "Weather app: pluggable weather data sources and the app built on them.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/app/server.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:live": "WEATHER_LIVE_TESTS=1 node --test \"src/**/*.live.test.ts\"",
    "typecheck": "tsc --noEmit",
    "probe": "node src/weather/probe.ts"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
