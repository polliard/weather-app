#!/bin/sh
# Praxis validation entry point: runs the repository's automated checks.
# Invoked by Praxis on every checkpoint; must exit non-zero on any failure.
set -eu

cd "$(dirname "$0")/.."

if [ -x node_modules/.bin/tsc ]; then
  echo "==> npm run typecheck"
  npm run typecheck
else
  echo "==> typecheck skipped: dev dependencies not installed (run 'npm ci')"
fi

# Runs every offline test and fails if coverage of the application code
# drops below the floor declared in package.json (lines 95%, branches 85%,
# functions 90%). Test support under src/testing/ is excluded from the floor.
echo "==> npm run test:coverage"
npm run test:coverage
