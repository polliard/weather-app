#!/bin/sh
# Praxis validation entry point: runs the repository's automated checks.
# Invoked by Praxis on every checkpoint; must exit non-zero on any failure.
set -eu

cd "$(dirname "$0")/.."

if [ -x node_modules/.bin/tsc ]; then
  echo "==> npm run typecheck"
  npm run typecheck
else
  echo "==> typecheck skipped: dev dependencies not installed (run 'npm ci')"
fi

echo "==> npm test"
npm test
